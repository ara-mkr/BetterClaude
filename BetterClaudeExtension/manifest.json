{
  "manifest_version": 3,
  "name": "BetterClaude",
  "version": "0.1.0",
  "description": "A BetterDiscord-style enhancement suite for Claude AI (browser extension build).",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "notifications", "tabs", "downloads", "clipboardWrite", "alarms"],
  "host_permissions": [
    "https://claude.ai/*",
    "https://api.github.com/*",
    "https://raw.githubusercontent.com/*",
    "https://codeload.github.com/*",
    "https://api.open-meteo.com/*"
  ],
  "background": {
    "service_worker": "dist/service-worker.bundle.js"
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": [
        "dist/core.bundle.js",
        "dist/settings-panel.bundle.js",
        "dist/snake.bundle.js",
        "dist/plugins/conversation-export.bundle.js",
        "dist/plugins/conversation-search.bundle.js",
        "dist/plugins/focus-mode.bundle.js",
        "dist/plugins/goal-tracker.bundle.js",
        "dist/plugins/markdown-plus.bundle.js",
        "dist/plugins/pomodoro-timer.bundle.js",
        "dist/plugins/quick-prompts.bundle.js",
        "dist/plugins/quote-of-the-day.bundle.js",
        "dist/plugins/snippet-library.bundle.js",
        "dist/plugins/sticky-notes.bundle.js",
        "dist/plugins/world-clock.bundle.js",
        "content/bridge.js",
        "content/file-watcher.js",
        "content/content-script.js"
      ],
      "css": [
        "dist/ui/hud/hud.css",
        "dist/ui/settings-panel/panel.css",
        "dist/ui/overlays.css",
        "dist/ui/skill-marketplace.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["dist/*", "dist/plugins/*"],
      "matches": ["https://claude.ai/*"]
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "commands": {
    "toggle-settings": {
      "suggested_key": { "default": "Ctrl+Shift+B", "mac": "Command+Shift+B" },
      "description": "Open BetterClaude Settings"
    },
    "open-command-palette": {
      "suggested_key": { "default": "Ctrl+K", "mac": "Command+K" },
      "description": "Open the Command Palette"
    },
    "open-prompt-picker": {
      "suggested_key": { "default": "Ctrl+Shift+P", "mac": "Command+Shift+P" },
      "description": "Open the Prompt Library picker"
    },
    "toggle-zen-mode": {
      "suggested_key": { "default": "Ctrl+Shift+F", "mac": "Command+Shift+F" },
      "description": "Toggle Zen Mode"
    }
  }
}
