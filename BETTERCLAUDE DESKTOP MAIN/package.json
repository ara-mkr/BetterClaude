{
  "name": "betterclaude",
  "productName": "BetterClaude",
  "version": "0.2.0",
  "description": "A BetterDiscord-style enhancement suite for Claude AI (Electron desktop app)",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/fix-dev-app-name.js && node scripts/fix-pty-spawn-helper.js",
    "build:core": "node esbuild.config.js",
    "audit": "node scripts/audit.js",
    "audit:layout": "npm run build:core && electron scripts/audit-layout-probe.js",
    "audit:dom": "electron scripts/audit-claude-dom.js",
    "clipboard-relay": "node scripts/clipboard-relay-server.js",
    "regen-themes": "node scripts/regen-themes.js",
    "start": "npm run build:core && electron .",
    "dev": "node scripts/dev-watch.js",
    "pack": "npm run build:core && electron-builder",
    "build:mac": "npm run build:core && electron-builder --mac --arm64 --x64",
    "build:mac:arm64": "npm run build:core && electron-builder --mac --arm64",
    "build:mac:intel": "npm run build:core && electron-builder --mac --x64",
    "build:win": "npm run build:core && electron-builder --win --x64",
    "build:all": "npm run build:core && electron-builder --mac --arm64 --x64 --win --x64"
  },
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ara-mkr/betterclaude.git"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.24.0"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.0",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "adm-zip": "^0.5.18",
    "chokidar": "^3.6.0",
    "codemirror": "^6.0.1",
    "diff": "^7.0.0",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9",
    "node-pty": "^1.1.0",
    "sql.js": "^1.14.1"
  },
  "build": {
    "appId": "com.betterclaude.app",
    "productName": "BetterClaude",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ara-mkr",
        "repo": "betterclaude"
      }
    ],
    "files": [
      "core/**/*",
      "electron/**/*",
      "ui/**/*",
      "themes/**/*",
      "plugins/**/*",
      "build/*.bundle.js",
      "assets/**/*",
      "resources/**/*",
      "package.json",
      "!**/*.map",
      "!esbuild.config.js"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "dmg": {
      "background": "build/background.png",
      "iconSize": 96,
      "window": {
        "width": 660,
        "height": 330
      },
      "contents": [
        {
          "x": 165,
          "y": 150,
          "type": "file"
        },
        {
          "x": 495,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
